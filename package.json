{
  "name": "bu-secure-exam",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run prepare:assets && next dev",
    "build": "npm run prepare:assets && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude tests/e2e.spec.ts",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.data/browsers playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "prepare:assets": "node scripts/assets.mjs",
    "admin:create": "tsx scripts/admin.ts",
    "format": "prettier --write src scripts tests *.ts *.mjs *.json",
    "browsers:install": "PLAYWRIGHT_BROWSERS_PATH=.data/browsers playwright install chromium",
    "db:local": "tsx scripts/local-db.ts",
    "audit:verify": "tsx scripts/verify-audit.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@monaco-editor/react": "4.7.0",
    "@vercel/blob": "2.8.1",
    "@vercel/oidc": "^4.0.0",
    "bcryptjs": "3.0.3",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "google-auth-library": "11.2.0",
    "idb-keyval": "6.3.0",
    "katex": "0.19.0",
    "lucide-react": "1.54.0",
    "next": "16.4.0",
    "next-auth": "4.24.15",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.6",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "type": "module",
  "overrides": {
    "katex": "$katex",
    "dompurify": "^3.4.16",
    "uuid": "^11.1.1"
  }
}
