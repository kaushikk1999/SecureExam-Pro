# Use a managed, pooled PostgreSQL URL in production. Never commit real credentials.
DATABASE_PROVIDER=postgres
DATABASE_URL=
# PGlite is for isolated tests only. Use npm run db:local for development.
PGLITE_PATH=./.data/db
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local seed only. Generate privately; no universal password exists.
SEED_PASSWORD=
# Administrator bootstrap: remove after running npm run admin:create.
BOOTSTRAP_ROLE=ADMIN
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_MFA_SECRET=
MFA_ENCRYPTION_KEY=
REQUIRE_TEACHER_MFA=false
# Polling uses authenticated HTTPS, 3s teacher / 5s student / 15s heartbeat.
BLOB_READ_WRITE_TOKEN=
# Google Sheets export via Vercel OIDC / Google Workload Identity Federation.
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GCP_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEET_ID=
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma3:4b
CRON_SECRET=

# Optional university OpenID Connect (issuer must exactly match the ID-token issuer)
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# AMR claim required when local MFA or teacher MFA is required
SSO_REQUIRED_AMR=mfa
# Google sign-in callback /api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional first-login provisioning; only verified Workspace domains listed here
# can create accounts. New accounts are STUDENT unless listed by exact email below.
GOOGLE_AUTO_PROVISION_DOMAINS=
GOOGLE_TEACHER_EMAILS=
